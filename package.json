{
  "name": "ideabylunch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx tsx scripts/check-env.ts && next build",
    "start": "next start",
    "validate": "node scripts/validate.js",
    "deploy": "node scripts/validate.js && NODE_ENV=production npx tsx scripts/check-env.ts && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check": "node scripts/validate.js",
    "check-env": "npx tsx scripts/check-env.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@sentry/nextjs": "^10.74.0",
    "@upstash/redis": "^1.28.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "next": "^15.5.18",
    "openai": "^4.52.0",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^3.3.0",
    "stripe": "^16.2.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5",
    "wrangler": "^4.168.0"
  }
}
